#!/usr/bin/env python3
"""mvc - mv for folders that also migrates Claude Code state.

Usage: mvc [-v] [-n] [--history=merge|overwrite|abort] SRC DEST

Moves SRC to DEST (mv semantics: if DEST is an existing dir, SRC goes inside it),
then rewrites Claude Code state so `claude -c` / `claude -r` work from the new
location with full history:
  ~/.claude/projects/<encoded-path>/   renamed, "cwd" fields rewritten
  ~/.claude.json                       "projects" keys remapped
  ~/.claude/history.jsonl              "project" fields rewritten
Sub-folders of SRC that have their own Claude projects are migrated too.
Silent on success like mv; -v shows each step, -n (dry run) implies -v.
Backups of ~/.claude.json and history.jsonl are written next to them as *.mvc-bak.

If DEST already has Claude history (e.g. from a folder that was deleted), mvc asks
what to do, or use --history:
  merge      keep both; on a file-name clash the existing DEST copy wins
  overwrite  replace DEST's history with SRC's (old copy saved in ~/.claude/mvc-backups)
  abort      stop before moving anything
Without a terminal and without --history it aborts.
"""
import json
import os
import re
import shutil
import sys
import time

CLAUDE_DIR = os.environ.get("CLAUDE_CONFIG_DIR", os.path.expanduser("~/.claude"))
PROJECTS = os.path.join(CLAUDE_DIR, "projects")
HISTORY = os.path.join(CLAUDE_DIR, "history.jsonl")
GLOBAL_CFG = os.path.expanduser("~/.claude.json")
if os.environ.get("CLAUDE_CONFIG_DIR"):
    GLOBAL_CFG = os.path.join(CLAUDE_DIR, ".claude.json")


VERBOSE = False


def log(msg):
    if VERBOSE:
        print(msg)


def encode(path):
    return re.sub(r"[^a-zA-Z0-9]", "-", path)


def remap(path, src, dst):
    if path == src:
        return dst
    if path.startswith(src + "/"):
        return dst + path[len(src):]
    return None


def project_cwd(pdir):
    """Real path of a project dir, read from the first cwd found in its sessions."""
    for name in sorted(os.listdir(pdir)):
        if not name.endswith(".jsonl"):
            continue
        try:
            with open(os.path.join(pdir, name), encoding="utf-8") as f:
                for line in f:
                    m = re.search(r'"cwd":("(?:[^"\\]|\\.)*")', line)
                    if m:
                        return json.loads(m.group(1))
        except OSError:
            pass
    return None


def rewrite_text(text, src, dst, key):
    """Replace JSON string values of `key` equal to / under src."""
    pat = re.compile(r'("%s":)("(?:[^"\\]|\\.)*")' % re.escape(key))

    def sub(m):
        try:
            val = json.loads(m.group(2))
        except ValueError:
            return m.group(0)
        new = remap(val, src, dst)
        if new is None:
            return m.group(0)
        return m.group(1) + json.dumps(new, ensure_ascii=False)

    return pat.sub(sub, text)


def backup(path):
    bak = path + ".mvc-bak"
    if not os.path.exists(bak):
        shutil.copy2(path, bak)


def rewrite_file(path, fn, keep_backup=True):
    with open(path, encoding="utf-8") as f:
        old = f.read()
    new = fn(old)
    if new != old:
        if keep_backup:
            backup(path)
        tmp = path + ".mvc-tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(new)
        shutil.copystat(path, tmp)
        os.replace(tmp, path)
        return True
    return False


def plan_projects(src, dst):
    """[(project_dir, target_dir)] for every Claude project at/under src."""
    moves = []
    if not os.path.isdir(PROJECTS):
        return moves
    for name in sorted(os.listdir(PROJECTS)):
        pdir = os.path.join(PROJECTS, name)
        if not os.path.isdir(pdir):
            continue
        cwd = project_cwd(pdir)
        if cwd is None:
            # no sessions to read; fall back to exact encoded-name match
            cwd = src if name == encode(src) else None
        new_cwd = remap(cwd, src, dst) if cwd else None
        if new_cwd is not None:
            moves.append((pdir, os.path.join(PROJECTS, encode(new_cwd))))
    return moves


def load_cfg():
    if not os.path.isfile(GLOBAL_CFG):
        return None
    try:
        with open(GLOBAL_CFG, encoding="utf-8") as f:
            cfg = json.load(f)
    except (OSError, ValueError) as e:
        print(f"mvc: warning: skipping {GLOBAL_CFG}: {e}", file=sys.stderr)
        return None
    return cfg if isinstance(cfg.get("projects"), dict) else None


def find_conflicts(src, dst, moves, cfg):
    """Existing Claude state at the destination that the move would collide with."""
    found = []
    for pdir, target in moves:
        if target != pdir and os.path.isdir(target) and os.listdir(target):
            found.append(f"sessions: {target}")
    if cfg:
        for k in cfg["projects"]:
            nk = remap(k, src, dst)
            if nk is not None and nk != k and nk in cfg["projects"]:
                found.append(f"settings in ~/.claude.json: {nk}")
    return found


def ask_policy(conflicts, dst):
    print(f"mvc: destination already has Claude Code history ({dst}):", file=sys.stderr)
    for c in conflicts:
        print(f"  - {c}", file=sys.stderr)
    if not (sys.stdin.isatty() and sys.stderr.isatty()):
        print("mvc: not a terminal; pass --history=merge|overwrite|abort", file=sys.stderr)
        return "abort"
    while True:
        try:
            ans = input("[m]erge both, [o]verwrite destination history, [a]bort? ").strip().lower()
        except EOFError:
            return "abort"
        for word in ("merge", "overwrite", "abort"):
            if ans and word.startswith(ans):
                return word


def stash(path):
    """Move an existing project dir out of the way, keeping it as a backup."""
    bdir = os.path.join(CLAUDE_DIR, "mvc-backups")
    os.makedirs(bdir, exist_ok=True)
    dest = os.path.join(bdir, f"{os.path.basename(path)}.{time.strftime('%Y%m%d-%H%M%S')}")
    os.rename(path, dest)
    log(f"  old destination history saved to {dest}")


def migrate(src, dst, dry, moves, cfg, policy):
    # 1. project dirs
    for pdir, target in moves:
        log(f"project: {os.path.basename(pdir)} -> {os.path.basename(target)}")
        if dry:
            continue
        for fn in os.listdir(pdir):
            if fn.endswith(".jsonl"):
                rewrite_file(os.path.join(pdir, fn),
                             lambda t: rewrite_text(t, src, dst, "cwd"),
                             keep_backup=False)
        if target == pdir:
            continue
        if os.path.exists(target):
            if policy == "overwrite":
                stash(target)
                os.rename(pdir, target)
            else:
                merge(pdir, target)
        else:
            os.rename(pdir, target)

    # 2. ~/.claude.json
    if cfg:
        projs = cfg["projects"]
        changed = {k: remap(k, src, dst) for k in projs if remap(k, src, dst) is not None}
        if changed:
            log(f"~/.claude.json: {len(changed)} project entr{'y' if len(changed) == 1 else 'ies'}")
            if not dry:
                new = {k: v for k, v in projs.items() if k not in changed}
                for k, nk in changed.items():
                    if nk in new and policy == "merge" and isinstance(new[nk], dict) \
                            and isinstance(projs[k], dict):
                        new[nk] = {**projs[k], **new[nk]}  # existing destination wins
                    elif nk in new and policy == "merge":
                        pass
                    else:
                        new[nk] = projs[k]
                cfg["projects"] = new
                backup(GLOBAL_CFG)
                tmp = GLOBAL_CFG + ".mvc-tmp"
                with open(tmp, "w", encoding="utf-8") as f:
                    json.dump(cfg, f, indent=2, ensure_ascii=False)
                shutil.copystat(GLOBAL_CFG, tmp)
                os.replace(tmp, GLOBAL_CFG)

    # 3. history.jsonl
    if os.path.isfile(HISTORY):
        if dry:
            log("history.jsonl: would rewrite project fields")
        elif rewrite_file(HISTORY, lambda t: rewrite_text(t, src, dst, "project")):
            log("history.jsonl: updated")


def merge(a, b):
    for fn in os.listdir(a):
        pa, pb = os.path.join(a, fn), os.path.join(b, fn)
        if os.path.isdir(pa) and os.path.isdir(pb):
            merge(pa, pb)
        elif os.path.exists(pb):
            print(f"mvc: kept existing {pb} (source copy left in {pa})", file=sys.stderr)
        else:
            os.rename(pa, pb)
            log(f"  merged: {fn}")
    try:
        os.rmdir(a)
    except OSError:
        pass


def main(argv):
    global VERBOSE
    dry = False
    policy = None
    args = []
    for a in argv:
        if a.startswith("--history="):
            policy = a.split("=", 1)[1]
            if policy not in ("merge", "overwrite", "abort"):
                print("mvc: --history must be merge, overwrite or abort", file=sys.stderr)
                return 2
        elif a in ("-n", "--dry-run"):
            dry = True
            VERBOSE = True
        elif a in ("-v", "--verbose"):
            VERBOSE = True
        else:
            args.append(a)
    if len(args) != 2:
        print(__doc__, file=sys.stderr)
        return 2
    src_arg, dst_arg = args
    src_arg = src_arg.rstrip("/") or "/"
    if not os.path.isdir(src_arg) or os.path.islink(src_arg):
        print(f"mvc: '{src_arg}' is not a directory", file=sys.stderr)
        return 1
    src = os.path.realpath(src_arg)
    dst = os.path.abspath(os.path.expanduser(dst_arg))
    if os.path.isdir(dst):
        dst = os.path.join(os.path.realpath(dst), os.path.basename(src))
    else:
        dst = os.path.join(os.path.realpath(os.path.dirname(dst)), os.path.basename(dst))
    if os.path.exists(dst):
        print(f"mvc: '{dst}' already exists", file=sys.stderr)
        return 1
    if dst == src or dst.startswith(src + "/"):
        print("mvc: cannot move a directory into itself", file=sys.stderr)
        return 1

    moves = plan_projects(src, dst)
    cfg = load_cfg()
    conflicts = find_conflicts(src, dst, moves, cfg)
    if conflicts:
        if dry:
            log("destination already has Claude history:")
            for c in conflicts:
                log(f"  - {c}")
            log(f"  policy: {policy or 'ask'}")
        else:
            chosen = policy or ask_policy(conflicts, dst)
            if chosen == "abort":
                print("mvc: aborted, nothing was moved", file=sys.stderr)
                return 1
            policy = chosen

    log(f"{src} -> {dst}")
    if not dry:
        try:
            shutil.move(src, dst)
        except OSError as e:
            print(f"mvc: move failed: {e}", file=sys.stderr)
            return 1
    migrate(src, dst, dry, moves, cfg, policy)
    if dry:
        log("(dry run, nothing changed)")
    else:
        log(f"done. cd '{dst}' && claude -c")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
